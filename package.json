{
  "name": "neko",
  "version": "0.1.3",
  "description": "Neko — elegant break reminder for desktop",
  "type": "module",
  "author": "",
  "license": "PolyForm-Noncommercial-1.0.0",
  "homepage": "https://github.com/rokiai/neko",
  "productName": "Neko",
  "packageManager": "pnpm@10.12.4",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "build:mac": "tauri build --bundles app,dmg",
    "build:win": "tauri build --bundles nsis",
    "build:linux": "tauri build --bundles appimage,deb",
    "typecheck": "tsc --noEmit",
    "rust:format:check": "cd src-tauri && cargo fmt --all --check",
    "rust:lint": "cd src-tauri && cargo clippy --all-targets -- -D warnings",
    "rust:test": "cd src-tauri && cargo test",
    "tauri:check": "cd src-tauri && cargo check --all-targets",
    "lint": "eslint --cache .",
    "lint:fix": "eslint --cache --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "ci": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run rust:format:check && pnpm run rust:lint && pnpm run rust:test && pnpm run tauri:check && pnpm run build",
    "sync:readme": "node scripts/sync-readme-download-links.mjs",
    "sync:readme:check": "node scripts/sync-readme-download-links.mjs --check",
    "release:manifest": "node scripts/write-release-manifest.mjs",
    "version": "pnpm sync:readme && git add README.md README.zh-CN.md",
    "prepare": "husky"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.0",
    "antd": "^6.5.1",
    "i18next": "^26.3.6",
    "react-i18next": "^17.0.10"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.0",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.7.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^7.2.6",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,yml,yaml,md,css,html}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  }
}
